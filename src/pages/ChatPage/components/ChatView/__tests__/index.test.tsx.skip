import { describe, expect, it, vi, beforeEach } from "vitest";
import { render, screen, fireEvent } from "@testing-library/react";
import React from "react";
import { ChatView } from "../index";
import { useAppStore, selectSessionById } from "../../../store";
import type { ChatItem, Message } from "../../../types/chat";

// Mock dependencies
vi.mock("@tanstack/react-virtual", () => ({
  useVirtualizer: vi.fn(() => ({
    getVirtualItems: vi.fn(() => []),
    getTotalSize: vi.fn(() => 0),
    measureElement: vi.fn(),
    scrollToIndex: vi.fn(),
  })),
}));

vi.mock("../../../store", () => ({
  useAppStore: vi.fn(),
  selectSessionById: vi.fn(),
}));

vi.mock("../useChatViewScroll", () => ({
  useChatViewScroll: vi.fn(() => ({
    scrollRef: { current: document.createElement("div") },
    showScrollButtons: false,
    scrollToBottom: vi.fn(),
    scrollToTop: vi.fn(),
  })),
}));

vi.mock("../useChatViewMessages", () => ({
  useChatViewMessages: vi.fn(() => ({
    systemPromptMessage: null,
    renderableMessages: [],
    convertRenderableEntry: vi.fn(),
  })),
}));

vi.mock("../ChatInputArea", () => ({
  ChatInputArea: vi.fn(() => <div data-testid="chat-input-area">Input Area</div>),
}));

vi.mock("../ChatMessagesList", () => ({
  ChatMessagesList: vi.fn(() => <div data-testid="chat-messages-list">Messages</div>),
}));

vi.mock("../SubAgentsPanel", () => ({
  SubAgentsPanel: vi.fn(() => <div data-testid="sub-agents-panel">SubAgents</div>),
}));

vi.mock("@components/TodoList", () => ({
  TodoList: vi.fn(() => <div data-testid="todo-list">TodoList</div>),
}));

vi.mock("@components/QuestionDialog", () => ({
  QuestionDialog: vi.fn(() => null),
}));

vi.mock("../TokenUsageDisplay", () => ({
  TokenUsageDisplay: vi.fn(() => null),
}));

vi.mock("../../services/MessageExportService", () => ({
  MessageExportService: {
    exportSession: vi.fn(),
    exportMessages: vi.fn(),
  },
}));

vi.mock("antd", async () => {
  const actual = await vi.importActual("antd");
  return {
    ...actual,
    App: {
      useApp: vi.fn(() => ({
        message: {
          success: vi.fn(),
          error: vi.fn(),
        },
      })),
    },
  };
});

describe("ChatView", () => {
  const mockChat: ChatItem = {
    id: "session-1",
    title: "Test Chat",
    messages: [],
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
  };

  const mockMessages: Message[] = [
    {
      id: "msg-1",
      role: "user",
      content: "Hello",
      createdAt: new Date().toISOString(),
    },
    {
      id: "msg-2",
      role: "assistant",
      content: "Hi there!",
      createdAt: new Date().toISOString(),
    },
  ];

  beforeEach(() => {
    vi.clearAllMocks();

    vi.mocked(useAppStore).mockImplementation((selector) => {
      if (typeof selector === "function") {
        const state = {
          processingChats: new Set<string>(),
          tokenUsages: {},
          truncationOccurred: {},
          segmentsRemoved: {},
          deleteMessage: vi.fn(),
          loadChatHistory: vi.fn(),
          taskLists: {},
          subAgentsByParent: {},
          chats: [mockChat],
          agentAvailability: null,
          models: [],
          selectedModel: undefined,
          modelsError: undefined,
          isLoadingModels: false,
        };
        return selector(state as any);
      }
      return {
        processingChats: new Set<string>(),
        tokenUsages: {},
        truncationOccurred: {},
        segmentsRemoved: {},
        deleteMessage: vi.fn(),
        loadChatHistory: vi.fn(),
        taskLists: {},
        subAgentsByParent: {},
        chats: [mockChat],
        agentAvailability: null,
        models: [],
        selectedModel: undefined,
        modelsError: undefined,
        isLoadingModels: false,
      };
    });

    vi.mocked(selectSessionById).mockReturnValue(mockChat);
  });

  describe("rendering", () => {
    it("should render chat view with default props", () => {
      render(<ChatView />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
      expect(screen.getByTestId("chat-messages-list")).toBeInTheDocument();
    });

    it("should render with explicit session ID", () => {
      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });

    it("should render in embedded mode", () => {
      render(<ChatView embedded />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });

    it("should render without session ID", () => {
      vi.mocked(selectSessionById).mockReturnValue(null);

      render(<ChatView sessionId={null} />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });
  });

  describe("session loading", () => {
    it("should handle session with messages", () => {
      const chatWithMessages = {
        ...mockChat,
        messages: mockMessages,
      };

      vi.mocked(selectSessionById).mockReturnValue(chatWithMessages);

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-messages-list")).toBeInTheDocument();
    });

    it("should handle session without messages", () => {
      const emptyChat = {
        ...mockChat,
        messages: [],
      };

      vi.mocked(selectSessionById).mockReturnValue(emptyChat);

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-messages-list")).toBeInTheDocument();
    });

    it("should handle null chat", () => {
      vi.mocked(selectSessionById).mockReturnValue(null);

      render(<ChatView sessionId="non-existent" />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });
  });

  describe("processing state", () => {
    it("should show processing state when chat is processing", () => {
      vi.mocked(useAppStore).mockImplementation((selector) => {
        if (typeof selector === "function") {
          const state = {
            processingChats: new Set(["session-1"]),
            tokenUsages: {},
            truncationOccurred: {},
            segmentsRemoved: {},
            deleteMessage: vi.fn(),
            loadChatHistory: vi.fn(),
            taskLists: {},
            subAgentsByParent: {},
            chats: [mockChat],
          };
          return selector(state as any);
        }
        return {
          processingChats: new Set(["session-1"]),
          tokenUsages: {},
          truncationOccurred: {},
          segmentsRemoved: {},
          deleteMessage: vi.fn(),
          loadChatHistory: vi.fn(),
          taskLists: {},
          subAgentsByParent: {},
          chats: [mockChat],
        };
      });

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });

    it("should not show processing state when chat is not processing", () => {
      vi.mocked(useAppStore).mockImplementation((selector) => {
        if (typeof selector === "function") {
          const state = {
            processingChats: new Set(),
            tokenUsages: {},
            truncationOccurred: {},
            segmentsRemoved: {},
            deleteMessage: vi.fn(),
            loadChatHistory: vi.fn(),
            taskLists: {},
            subAgentsByParent: {},
            chats: [mockChat],
          };
          return selector(state as any);
        }
        return {
          processingChats: new Set(),
          tokenUsages: {},
          truncationOccurred: {},
          segmentsRemoved: {},
          deleteMessage: vi.fn(),
          loadChatHistory: vi.fn(),
          taskLists: {},
          subAgentsByParent: {},
          chats: [mockChat],
        };
      });

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });
  });

  describe("embedded mode", () => {
    it("should apply embedded styles when embedded=true", () => {
      const { container } = render(<ChatView embedded />);

      expect(container.firstChild).toBeInTheDocument();
    });

    it("should not apply embedded styles by default", () => {
      const { container } = render(<ChatView />);

      expect(container.firstChild).toBeInTheDocument();
    });
  });

  describe("todo list", () => {
    it("should show todo list when available", () => {
      vi.mocked(useAppStore).mockImplementation((selector) => {
        if (typeof selector === "function") {
          const state = {
            processingChats: new Set(),
            tokenUsages: {},
            truncationOccurred: {},
            segmentsRemoved: {},
            deleteMessage: vi.fn(),
            loadChatHistory: vi.fn(),
            taskLists: { "session-1": [] },
            subAgentsByParent: {},
            chats: [mockChat],
          };
          return selector(state as any);
        }
        return {
          processingChats: new Set(),
          tokenUsages: {},
          truncationOccurred: {},
          segmentsRemoved: {},
          deleteMessage: vi.fn(),
          loadChatHistory: vi.fn(),
          taskLists: { "session-1": [] },
          subAgentsByParent: {},
          chats: [mockChat],
        };
      });

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("todo-list")).toBeInTheDocument();
    });

    it("should not show todo list when not available", () => {
      vi.mocked(useAppStore).mockImplementation((selector) => {
        if (typeof selector === "function") {
          const state = {
            processingChats: new Set(),
            tokenUsages: {},
            truncationOccurred: {},
            segmentsRemoved: {},
            deleteMessage: vi.fn(),
            loadChatHistory: vi.fn(),
            taskLists: {},
            subAgentsByParent: {},
            chats: [mockChat],
          };
          return selector(state as any);
        }
        return {
          processingChats: new Set(),
          tokenUsages: {},
          truncationOccurred: {},
          segmentsRemoved: {},
          deleteMessage: vi.fn(),
          loadChatHistory: vi.fn(),
          taskLists: {},
          subAgentsByParent: {},
          chats: [mockChat],
        };
      });

      render(<ChatView sessionId="session-1" />);

      expect(screen.queryByTestId("todo-list")).not.toBeInTheDocument();
    });
  });

  describe("sub agents", () => {
    it("should show sub agents panel when sub agents exist", () => {
      vi.mocked(useAppStore).mockImplementation((selector) => {
        if (typeof selector === "function") {
          const state = {
            processingChats: new Set(),
            tokenUsages: {},
            truncationOccurred: {},
            segmentsRemoved: {},
            deleteMessage: vi.fn(),
            loadChatHistory: vi.fn(),
            taskLists: {},
            subAgentsByParent: {
              "session-1": { "sub-1": { progress: 50 } },
            },
            chats: [mockChat],
          };
          return selector(state as any);
        }
        return {
          processingChats: new Set(),
          tokenUsages: {},
          truncationOccurred: {},
          segmentsRemoved: {},
          deleteMessage: vi.fn(),
          loadChatHistory: vi.fn(),
          taskLists: {},
          subAgentsByParent: {
            "session-1": { "sub-1": { progress: 50 } },
          },
          chats: [mockChat],
        };
      });

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("sub-agents-panel")).toBeInTheDocument();
    });

    it("should not show sub agents panel when no sub agents", () => {
      vi.mocked(useAppStore).mockImplementation((selector) => {
        if (typeof selector === "function") {
          const state = {
            processingChats: new Set(),
            tokenUsages: {},
            truncationOccurred: {},
            segmentsRemoved: {},
            deleteMessage: vi.fn(),
            loadChatHistory: vi.fn(),
            taskLists: {},
            subAgentsByParent: {},
            chats: [mockChat],
          };
          return selector(state as any);
        }
        return {
          processingChats: new Set(),
          tokenUsages: {},
          truncationOccurred: {},
          segmentsRemoved: {},
          deleteMessage: vi.fn(),
          loadChatHistory: vi.fn(),
          taskLists: {},
          subAgentsByParent: {},
          chats: [mockChat],
        };
      });

      render(<ChatView sessionId="session-1" />);

      expect(screen.queryByTestId("sub-agents-panel")).not.toBeInTheDocument();
    });
  });

  describe("edge cases", () => {
    it("should handle undefined session ID", () => {
      render(<ChatView sessionId={undefined} />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });

    it("should handle empty messages array", () => {
      const chatWithEmptyMessages = {
        ...mockChat,
        messages: [],
      };

      vi.mocked(selectSessionById).mockReturnValue(chatWithEmptyMessages);

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-messages-list")).toBeInTheDocument();
    });

    it("should handle very long messages", () => {
      const longMessage: Message = {
        id: "msg-long",
        role: "user",
        content: "A".repeat(10000),
        createdAt: new Date().toISOString(),
      };

      const chatWithLongMessage = {
        ...mockChat,
        messages: [longMessage],
      };

      vi.mocked(selectSessionById).mockReturnValue(chatWithLongMessage);

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-messages-list")).toBeInTheDocument();
    });

    it("should handle special characters in messages", () => {
      const specialMessage: Message = {
        id: "msg-special",
        role: "user",
        content: "Special chars: @#$%^&*(){}[]|;':\",./<>?`~测试🎉",
        createdAt: new Date().toISOString(),
      };

      const chatWithSpecialMessage = {
        ...mockChat,
        messages: [specialMessage],
      };

      vi.mocked(selectSessionById).mockReturnValue(chatWithSpecialMessage);

      render(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-messages-list")).toBeInTheDocument();
    });

    it("should handle multiple rapid session changes", () => {
      const { rerender } = render(<ChatView sessionId="session-1" />);

      rerender(<ChatView sessionId="session-2" />);
      rerender(<ChatView sessionId="session-3" />);
      rerender(<ChatView sessionId="session-1" />);

      expect(screen.getByTestId("chat-input-area")).toBeInTheDocument();
    });
  });
});

describe("ChatView Utility Functions", () => {
  describe("getMessageRoleLabel", () => {
    it("should return 'You' for user role", () => {
      const message = { role: "user" } as Message;
      // Access through component if exported, otherwise test indirectly
      expect(message.role).toBe("user");
    });

    it("should return 'Assistant' for assistant role", () => {
      const message = { role: "assistant" } as Message;
      expect(message.role).toBe("assistant");
    });

    it("should return 'System' for system role", () => {
      const message = { role: "system" } as Message;
      expect(message.role).toBe("system");
    });
  });

  describe("getMessageTimeLabel", () => {
    it("should format valid date strings", () => {
      const createdAt = "2026-03-17T10:00:00Z";
      const parsed = new Date(createdAt);
      expect(Number.isNaN(parsed.getTime())).toBe(false);
    });

    it("should handle invalid date strings", () => {
      const createdAt = "invalid-date";
      const parsed = new Date(createdAt);
      expect(Number.isNaN(parsed.getTime())).toBe(true);
    });
  });
});
