{
  "name": "@bigduu/lotus",
  "private": false,
  "version": "0.0.0",
  "description": "Standalone Lotus frontend assets for Bodhi shell and web runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigduu/Lotus"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:bamboo-package": "npm run build && node ../bamboo/scripts/frontend-package.cjs stage:prebuilt",
    "preview": "vite preview",
    "rebrand:public": "node scripts/rebrand.cjs --target=public",
    "rebrand:internal": "node scripts/rebrand.cjs --target=internal",
    "rebrand:check": "node scripts/rebrand.cjs --check",
    "build:public": "npm run rebrand:public && npm run build",
    "build:internal": "npm run rebrand:internal && npm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:e2e": "npm --prefix ./e2e run test --",
    "test:e2e:browser": "npm --prefix ./e2e run test:browser --",
    "test:e2e:with-server": "npm --prefix ./e2e run test:with-server --",
    "test:e2e:ui": "npm --prefix ./e2e run test:ui --",
    "test:e2e:debug": "npm --prefix ./e2e run test:debug --",
    "test:e2e:report": "npm --prefix ./e2e run test:report --",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "antd": "^5.24.7",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "dompurify": "^3.2.4",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.18",
    "jotai": "^2.20.0",
    "jotai-family": "^1.0.2",
    "jspdf": "^4.1.0",
    "mermaid": "^11.15.0",
    "openai": "^5.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^2.15.4",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
